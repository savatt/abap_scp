@Metadata.layer: #CORE
@UI.headerInfo: {
    typeName: 'Coche',
    typeNamePlural: 'Coches',
    typeImageUrl: '',
    imageUrl: 'Imagen',
    title: {
        type: #STANDARD,
        label: '',
        iconUrl: '',
        criticality: '',
        criticalityRepresentation: #WITHOUT_ICON,
        value: 'Marca',
        valueQualifier: '',
        targetElement: '',
        url: ''
    },
    description: {
        type: #STANDARD,
        label: '',
        iconUrl: '',
        criticality: '',
        criticalityRepresentation: #WITHOUT_ICON,
        value: 'Modelo',
        valueQualifier: '',
        targetElement: '',
        url: ''
    }
}
@Search.searchable: true
annotate view Z_I_RENTING with
{
  @UI.facet: [{ id: 'DetallesVehiculo', parentId: '', position: 10, label: 'Detalles del Vehículo', type: #COLLECTION},
              { id: 'Vehiculo', parentId: 'DetallesVehiculo', position: 10, label: 'Detalles', type: #FIELDGROUP_REFERENCE, targetQualifier: 'DetallesVehiculo'},
              { id: 'Cliente', parentId: '', position: 20, label: 'Clientes', type: #LINEITEM_REFERENCE, targetElement: '_DetCustomer'}]
  @UI.fieldGroup: [{ qualifier: 'DetallesVehiculo', position: 10 }]
  Matricula;

  @UI: { lineItem: [{ position: 10, importance: #HIGH }],
         selectionField: [{ position: 10 }] }
  @Consumption.valueHelpDefinition: [{ entity: { name: 'z_b_brands', element: 'Marca' } }]
  Marca;
  @UI.lineItem: [{ position: 20, importance: #HIGH }]
  @Search: { defaultSearchElement: true, ranking: #MEDIUM, fuzzinessThreshold: 0.8 }
  Modelo;
  @UI.lineItem: [{ position: 30, importance: #MEDIUM }]
  Color;
  @UI.lineItem: [{ position: 40, importance: #LOW }]
  @Search: { defaultSearchElement: true, ranking: #MEDIUM, fuzzinessThreshold: 0.8 }
  Motor;
  @UI.lineItem: [{ position: 50, importance: #LOW }]
  Potencia;
  @UI: { lineItem: [{ position: 60, importance: #HIGH }],
         selectionField: [{ position: 20 }] }
  Precio;
  @UI.lineItem: [{ position: 70, importance: #HIGH }]
  Moneda;
  @UI.lineItem: [{ position: 80, importance: #HIGH }]
  Alquilado;
  @UI.lineItem: [{ position: 90, label: 'Estado', importance: #HIGH, criticality: 'TiempoRenta' }]
  Estado;

  @UI.fieldGroup: [{ qualifier: 'DetallesVehiculo', position: 20 }]
  Combustible;
  @UI.fieldGroup: [{ qualifier: 'DetallesVehiculo', position: 30 }]
  Consumo;
  @UI.fieldGroup: [{ qualifier: 'DetallesVehiculo', position: 40 }]
  FechaFabr;
  @UI.fieldGroup: [{ qualifier: 'DetallesVehiculo', position: 50 }]
  Puertas;
}